<ui:FluentWindow x:Class="WpfApp.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:WpfApp"
                 Title="The New York Times"
                 Height="720"
                 Width="1180"
                 MinHeight="520"
                 MinWidth="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Related-story card, shared by the below-article and side-column lists. -->
        <DataTemplate x:Key="RelatedStoryTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenRelatedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="72"
                            Height="54"
                            Margin="0,0,12,0"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <local:ArticleImage Source="{Binding ImageUrl}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Title}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Description}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   MaxHeight="40" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title=""
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <!-- Masthead vector shared with the Compose top app bar. -->
                <Path Height="16"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Data="{StaticResource MastheadGeometry}"
                      Fill="{DynamicResource TextFillColorPrimaryBrush}"
                      Stretch="Uniform"
                      ToolTip="The New York Times" />
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <ui:Button Margin="0,0,8,0"
                           Appearance="Secondary"
                           Command="{Binding RefreshCommand}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           ToolTip="Refresh top stories" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Column widths and pane visibility are driven by MainWindow.ApplyLayout (compact / expanded / wide). -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SectionsColumn" Width="220" />
                <ColumnDefinition x:Name="StoriesColumn" Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Section navigation -->
            <Border x:Name="SectionsPane"
                    Grid.Column="0"
                    Margin="12,0,8,0"
                    Padding="0,4,0,8"
                    Style="{StaticResource PaneBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="16,14,16,8"
                               Style="{StaticResource LabelMediumTextStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="SECTIONS" />
                    <ListBox x:Name="SectionsList"
                             Margin="4,0,4,4"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Sections}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedSection}"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="4,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyMediumTextStyle}" Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Story list -->
            <Border x:Name="StoriesPane"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Padding="0"
                    Style="{StaticResource PaneBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,16,8">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource TitleLargeTextStyle}"
                                   Text="Top Stories" />
                        <ui:ProgressRing Width="22"
                                         Height="22"
                                         Margin="12,0,0,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             x:Name="ArticlesList"
                             Margin="4,0,4,8"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Articles}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedArticle}"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="4,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="88"
                                            Height="66"
                                            Margin="0,0,12,0"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <local:ArticleImage Source="{Binding ImageUrl}" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource LabelMediumTextStyle}"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Text="{Binding SectionName}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource TitleMediumTextStyle}"
                                                   Text="{Binding Title}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource BodySmallTextStyle}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="40" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource LabelSmallTextStyle}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding Byline}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Loading top stories..."
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Grid.Row="1"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding EmptyMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Row="1"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource TitleMediumTextStyle}"
                                   Text="{Binding ErrorTitle}"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Error}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <ui:Button Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Appearance="Secondary"
                                   Command="{Binding RefreshCommand}"
                                   Content="Retry"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    </StackPanel>

                    <!-- "Data provided by The New York Times" attribution, as under the Compose grid. -->
                    <ui:HyperlinkButton Grid.Row="2"
                                        Margin="8,0,8,4"
                                        HorizontalAlignment="Center"
                                        NavigateUri="https://developer.nytimes.com"
                                        ToolTip="developer.nytimes.com">
                        <Path Height="28"
                              Data="{StaticResource AttributionGeometry}"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"
                              Stretch="Uniform" />
                    </ui:HyperlinkButton>
                </Grid>
            </Border>

            <!-- Detail pane -->
            <Border x:Name="DetailPane"
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    Padding="20"
                    Style="{StaticResource PaneBorderStyle}">
                <ContentControl Content="{Binding SelectedStory}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right"
                                                            Margin="12,0,0,0"
                                                            Orientation="Horizontal">
                                                    <!-- Compact only: the detail covers the list, so offer a way back to it. -->
                                                    <ui:Button Margin="0,0,8,0"
                                                               Appearance="Secondary"
                                                               Command="{Binding DataContext.CloseStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Content="Stories"
                                                               Icon="{ui:SymbolIcon ChevronLeft24}"
                                                               ToolTip="Back to the story list"
                                                               Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ui:Button Margin="0,0,8,0"
                                                               Appearance="Secondary"
                                                               Command="{Binding DataContext.GoBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               IsEnabled="{Binding DataContext.CanGoBack, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Icon="{ui:SymbolIcon ArrowLeft24}"
                                                               ToolTip="Back to the previous story" />
                                                    <ui:Button Margin="0,0,8,0"
                                                               Appearance="Primary"
                                                               Command="{Binding SaveCommand}"
                                                               Content="Save"
                                                               Icon="{ui:SymbolIcon Bookmark24}" />
                                                    <ui:Button Appearance="Secondary"
                                                               Command="{Binding RefreshCommand}"
                                                               Content="Refresh"
                                                               Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelMediumTextStyle}"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                               Text="{Binding ArticleSectionName}" />
                                                    <TextBlock Margin="0,6,0,4"
                                                               Style="{StaticResource HeadlineSmallTextStyle}"
                                                               Text="{Binding ArticleTitle}" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding ArticleByline}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Article (and, below the wide breakpoint, related) on the left; side column opens when wide. -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition>
                                                        <ColumnDefinition.Style>
                                                            <Style TargetType="ColumnDefinition">
                                                                <Setter Property="Width" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWide, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Width" Value="2*" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ColumnDefinition.Style>
                                                    </ColumnDefinition>
                                                </Grid.ColumnDefinitions>

                                            <ScrollViewer Grid.Column="0"
                                                          Margin="0,16,0,0"
                                                          VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <ui:ProgressRing Width="28"
                                                                     Height="28"
                                                                     Margin="0,0,0,12"
                                                                     HorizontalAlignment="Left"
                                                                     IsIndeterminate="True"
                                                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <StackPanel Margin="0,0,0,16"
                                                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Style="{StaticResource TitleMediumTextStyle}"
                                                                   Text="{Binding ErrorTitle}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding Error}"
                                                                   TextWrapping="Wrap" />
                                                        <ui:Button Margin="0,8,0,0"
                                                                   HorizontalAlignment="Left"
                                                                   Appearance="Secondary"
                                                                   Command="{Binding RefreshCommand}"
                                                                   Content="Retry"
                                                                   Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                                    </StackPanel>

                                                    <Border Margin="0,0,0,16"
                                                            MaxHeight="240"
                                                            CornerRadius="8"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasArticleImage}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <local:ArticleImage Source="{Binding ArticleImageUrl}"
                                                                            Height="240" />
                                                    </Border>

                                                    <TextBlock Style="{StaticResource BodyMediumTextStyle}"
                                                               Text="{Binding ArticleDescription}" />
                                                    <TextBlock Margin="0,16,0,4"
                                                               Style="{StaticResource LabelSmallTextStyle}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="Read the full story" />
                                                    <ui:HyperlinkButton Padding="0"
                                                                        HorizontalAlignment="Left"
                                                                        Content="{Binding ArticleUrl}"
                                                                        Icon="{ui:SymbolIcon Open24}"
                                                                        NavigateUri="{Binding ArticleUrl}" />

                                                    <!-- Related below the article; in the wide layout it moves to the side column. -->
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWide, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                    <TextBlock Margin="0,24,0,8"
                                                               Style="{StaticResource TitleSmallTextStyle}"
                                                               Text="Related" />
                                                    <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource RelatedStoryTemplate}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>

                                                <!-- Wide only: related stories beside the article (60/40). -->
                                                <Grid Grid.Column="1" Margin="16,16,0,0">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWide, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Margin="0,0,0,8"
                                                               Style="{StaticResource TitleSmallTextStyle}"
                                                               Text="Related" />
                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource RelatedStoryTemplate}" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Grid>

                                            <StackPanel Grid.Row="2"
                                                        Margin="0,12,0,0"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,6,0"
                                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                               Symbol="CheckmarkCircle24">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           Text="Saved">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Width="40"
                                                                   Height="40"
                                                                   Margin="0,0,0,12"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="40"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Symbol="News24" />
                                                    <TextBlock HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="Select a story to read it here." />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
