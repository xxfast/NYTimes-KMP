<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- macOS IDEs load the full solution, so expose both the MAUI and Windows builds. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst;net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NYTimes.Windows</RootNamespace>
    <AssemblyName>NYTimes.Windows.Shared</AssemblyName>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">maccatalyst-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">x64</PlatformTarget>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)obj\packages</RestorePackagesPath>
    <!-- Generated Interop.cs uses reflection; MauiApp roots this assembly for Catalyst trimming. -->
    <NoWarn Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(NoWarn);IL2087;IL2090</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NYTimes.Kotlin" Version="$(NYTimesKotlinVersion)" />
  </ItemGroup>

</Project>
