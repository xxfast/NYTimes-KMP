<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NYTimes.MauiApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
    <Grid Padding="48">
        <Border
            MaximumWidthRequest="720"
            Padding="48"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
            Stroke="{StaticResource BrandColor}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1">
            <VerticalStackLayout Spacing="16">
                <BoxView
                    WidthRequest="48"
                    HeightRequest="4"
                    HorizontalOptions="Start"
                    Color="{StaticResource BrandColor}" />
                <Label
                    FontAttributes="Bold"
                    FontSize="36"
                    Text="The New York Times"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label
                    FontSize="20"
                    Text="MAUI desktop host"
                    TextColor="{StaticResource BrandColor}" />
                <Label
                    x:Name="BridgeStatusLabel"
                    FontSize="15"
                    LineBreakMode="WordWrap"
                    Text="Checking the Kotlin bridge…"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
