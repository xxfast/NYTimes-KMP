<Project>
  <!-- Shared NuGet feed for the locally packed NYTimes.Kotlin package. -->
  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)build\nuget</RestoreAdditionalProjectSources>
    <!-- Allow Rider and dotnet to restore/compile Windows projects from macOS. -->
    <EnableWindowsTargeting Condition="!$([MSBuild]::IsOSPlatform('windows'))">true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
